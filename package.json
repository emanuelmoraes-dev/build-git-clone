{
  "name": "build-git-clone",
  "version": "1.0.3",
  "description": "clone repositories in the desired folder, allowing custom commands to be executed within the cloned repository",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "test": "jest --no-cache"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/emanuelmoraes-dev/build-git-clone.git"
  },
  "keywords": [
    "git",
    "clone",
    "build"
  ],
  "author": "emanuelmoraes-dev",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/emanuelmoraes-dev/build-git-clone/issues"
  },
  "homepage": "https://github.com/emanuelmoraes-dev/build-git-clone#readme",
  "dependencies": {
    "rimraf": "^3.0.2"
  },
  "devDependencies": {
    "@types/jest": "^29.5.14",
    "@types/node": "^14.14.21",
    "@types/rimraf": "^3.0.0",
    "jest": "^29.7.0",
    "jest-util": "^29.7.0",
    "ts-jest": "^29.4.15",
    "ts-node": "^9.1.1",
    "typescript": "^4.1.3"
  },
  "jest": {
    "transform": {
      "^.+\\.ts$": "ts-jest"
    },
    "testRegex": "\\.test\\.ts$",
    "moduleFileExtensions": [
      "ts",
      "tsx",
      "js",
      "jsx",
      "json",
      "node"
    ]
  }
}
