{
  "name": "build-git-clone",
  "version": "1.1.0",
  "description": "Clone a Git repository into a destination folder",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "test": "jest --no-cache --runInBand"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/emanuelmoraes-dev/build-git-clone.git"
  },
  "keywords": [
    "git",
    "clone",
    "build"
  ],
  "author": "emanuelmoraes-dev",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/emanuelmoraes-dev/build-git-clone/issues"
  },
  "homepage": "https://github.com/emanuelmoraes-dev/build-git-clone#readme",
  "dependencies": {
    "rimraf": "^6.1.4"
  },
  "devDependencies": {
    "@types/jest": "^29.5.14",
    "@types/node": "^22.20.5",
    "jest": "^29.7.0",
    "jest-util": "^29.7.0",
    "ts-jest": "^29.4.15",
    "typescript": "^5.9.3"
  },
  "jest": {
    "transform": {
      "^.+\\.ts$": "ts-jest"
    },
    "testRegex": "\\.test\\.ts$",
    "moduleFileExtensions": [
      "ts",
      "tsx",
      "js",
      "jsx",
      "json",
      "node"
    ]
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=22"
  }
}
